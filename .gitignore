# Terraform local state and cache - these contain resource IDs and
# sometimes secrets, and are machine-specific, so they must never be committed
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json

# Excludes any .tfvars file - Project 5 uses one to pass a personal email
# address to the alert action group, which shouldn't be hardcoded into
# committed code even in an otherwise-public portfolio repo
*.tfvars

# Node / Vite build output (rpg-map-tracker) - regenerated by `npm run build`,
# never hand-edited, so there's no reason to version it
node_modules/
dist/

# Generated PowerShell script output (02-powershell-scripts) - a fresh
# timestamped CSV/HTML pair every run, regenerable on demand, not something
# to accumulate in git history
reports/

# Environment secrets (Supabase URL/key) - must never reach a public repo
.env
.env.*

# OS/editor noise
.DS_Store
Thumbs.db
